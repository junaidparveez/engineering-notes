{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // @types/node supplies both process.env and the fetch-style Request/Response
    // globals the serverless functions are written against. Types only - nothing
    // from it reaches the browser bundle.
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "api"]
}
